+/* ------------------------------------------------------------------ */
+/* Vazirmatn — self-hosted Persian/Arabic UI font used when the        */
+/* dashboard locale is "fa". SIL OFL 1.1.                              */
+/* ------------------------------------------------------------------ */
+
+@font-face {
+  font-family: 'Vazirmatn';
+  font-style: normal;
+  font-weight: 400;
+  font-display: swap;
+  src: url('/fonts-fa/Vazirmatn-Regular.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Vazirmatn';
+  font-style: normal;
+  font-weight: 600;
+  font-display: swap;
+  src: url('/fonts-fa/Vazirmatn-SemiBold.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Vazirmatn';
+  font-style: normal;
+  font-weight: 700;
+  font-display: swap;
+  src: url('/fonts-fa/Vazirmatn-Bold.woff2') format('woff2');
+}
+
 /* ------------------------------------------------------------------ */
 /* Hermes Agent — Nous DS with the LENS_0 (Hermes teal) palette applied
    statically as the default dashboard theme. */
@@ -141,6 +168,77 @@ code, kbd, pre, samp, .font-mono, .font-mono-ui {
   }
 }

+/* ------------------------------------------------------------------ */
+/* RTL (Persian) — <html dir="rtl"> is set by I18nProvider whenever    */
+/* the active locale is right-to-left (see i18n/context.tsx). Swaps    */
+/* the UI font to Vazirmatn and mirrors the layout; code/log/terminal  */
+/* content stays LTR since it's not natural-language text.             */
+/* ------------------------------------------------------------------ */
+html[dir='rtl'] {
+  /* !important is required here: ThemeProvider writes --theme-font-sans /
+     --theme-font-display as an INLINE style on <html> (see index.css's own
+     note above about theme tokens cascading from :root) whenever a theme
+     is applied, and inline styles beat a plain attribute-selector rule.
+     A stylesheet !important is the only thing that outranks that. */
+  --theme-font-sans: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+  --theme-font-display: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+  --theme-font-serif: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+  --font-sans: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+  --font-display: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+  --font-serif: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+}
+
+html[dir='rtl'],
+html[dir='rtl'] body,
+html[dir='rtl'] *,
+html[dir='rtl'] *::before,
+html[dir='rtl'] *::after {
+  font-family: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+}
+
+html[dir='rtl'] .font-sans,
+html[dir='rtl'] .font-serif,
+html[dir='rtl'] .font-display,
+html[dir='rtl'] .font-mondwest,
+html[dir='rtl'] .font-courier,
+html[dir='rtl'] .text-display,
+html[dir='rtl'] [class*='font-sans'],
+html[dir='rtl'] [class*='font-serif'],
+html[dir='rtl'] [class*='font-display'],
+html[dir='rtl'] [class*='font-mondwest'],
+html[dir='rtl'] [class*='font-courier'] {
+  font-family: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+}
+
+html[dir='rtl'] input,
+html[dir='rtl'] textarea,
+html[dir='rtl'] select,
+html[dir='rtl'] button {
+  font-family: 'Vazirmatn', system-ui, -apple-system, "Segoe UI",
+    Roboto, Helvetica, Arial, sans-serif !important;
+}
+
+html[dir='rtl'] code,
+html[dir='rtl'] kbd,
+html[dir='rtl'] pre,
+html[dir='rtl'] samp,
+html[dir='rtl'] .font-mono,
+html[dir='rtl'] .font-mono-ui,
+html[dir='rtl'] [class*='font-mono'],
+html[dir='rtl'] [class*='xterm'] {
+  direction: ltr;
+  unicode-bidi: isolate;
+  font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, Monaco, Consolas, "Vazirmatn", monospace !important;
+}
+
 /* Nousnet's hermes-agent layout bumps `small` and `code` to readable
    dashboard sizes. Keep in sync. */
 small { font-size: 1.0625rem; }
